{
  "info": {
    "name": "APIs RESTful - Alunos e Cursos",
    "description": "Colecao de testes para a API simulada (JSON-Server) e a API real (Express). Muda a variavel baseUrl para alternar entre http://localhost:3001 (json-server) e http://localhost:3000 (Express).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001"
    }
  ],
  "item": [
    {
      "name": "Alunos",
      "item": [
        {
          "name": "GET todos os alunos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/alunos",
              "host": ["{{baseUrl}}"],
              "path": ["alunos"]
            }
          }
        },
        {
          "name": "GET aluno por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/alunos/1",
              "host": ["{{baseUrl}}"],
              "path": ["alunos", "1"]
            }
          }
        },
        {
          "name": "POST criar aluno",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Novo\",\n  \"apelido\": \"Aluno\",\n  \"idCurso\": 1,\n  \"anoCurricular\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/alunos",
              "host": ["{{baseUrl}}"],
              "path": ["alunos"]
            }
          }
        },
        {
          "name": "PUT editar aluno",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Ana\",\n  \"apelido\": \"Silva Editado\",\n  \"idCurso\": 2,\n  \"anoCurricular\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/alunos/1",
              "host": ["{{baseUrl}}"],
              "path": ["alunos", "1"]
            }
          }
        },
        {
          "name": "DELETE apagar aluno",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/alunos/1",
              "host": ["{{baseUrl}}"],
              "path": ["alunos", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "Cursos",
      "item": [
        {
          "name": "GET todos os cursos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cursos",
              "host": ["{{baseUrl}}"],
              "path": ["cursos"]
            }
          }
        },
        {
          "name": "GET curso por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cursos/1",
              "host": ["{{baseUrl}}"],
              "path": ["cursos", "1"]
            }
          }
        }
      ]
    }
  ]
}
